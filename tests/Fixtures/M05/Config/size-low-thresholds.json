{
    "rules": {
        "size.file-length": {
            "thresholds": { "warning": 5, "error": 100 }
        },
        "size.method-length": {
            "thresholds": { "warning": 3, "error": 100 }
        },
        "size.class-length": {
            "thresholds": { "warning": 5, "error": 100 }
        },
        "size.parameter-count": {
            "thresholds": { "warning": 2, "error": 100 }
        },
        "size.public-method-count": {
            "thresholds": { "warning": 3, "error": 100 }
        },
        "size.property-count": {
            "thresholds": { "warning": 3, "error": 100 }
        },
        "size.average-method-length": {
            "thresholds": { "warning": 2, "error": 100 }
        }
    }
}
