<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         bootstrap="vendor/autoload.php"
         colors="true"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd">
    <testsuites>
        <testsuite name="unit">
            <directory suffix="Test.php">tests</directory>
            <exclude>tests/Console</exclude>
            <exclude>tests/Rule/Complexity/ComplexityIntegrationTest.php</exclude>
            <exclude>tests/Rule/Size/SizeIntegrationTest.php</exclude>
        </testsuite>
        <testsuite name="integration">
            <directory suffix="Test.php">tests/Console</directory>
            <file>tests/Rule/Complexity/ComplexityIntegrationTest.php</file>
            <file>tests/Rule/Size/SizeIntegrationTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
