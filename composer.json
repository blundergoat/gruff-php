{
    "name": "devgoat/gruff-php",
    "description": "Opinionated PHP code quality analyzer.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "nikic/php-parser": "^5.6",
        "symfony/console": "^6.4 || ^7.0 || ^8.0",
        "symfony/finder": "^6.4 || ^7.0 || ^8.0",
        "symfony/process": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "GruffPhp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GruffPhp\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/gruff"
    ],
    "scripts": {
        "check": [
            "composer validate --strict",
            "bash -n scripts/preflight-checks.sh",
            "@php -l bin/gruff",
            "@php -l src/Analysis/AnalysisReport.php",
            "@php -l src/Analysis/RunDiagnostic.php",
            "@php -l src/Command/AnalyseCommand.php",
            "@php -l src/Config/AnalysisConfig.php",
            "@php -l src/Config/ConfigException.php",
            "@php -l src/Config/ConfigLoader.php",
            "@php -l src/Config/RuleSettings.php",
            "@php -l src/Console/Application.php",
            "@php -l src/Finding/Confidence.php",
            "@php -l src/Finding/Finding.php",
            "@php -l src/Finding/Pillar.php",
            "@php -l src/Finding/RuleTier.php",
            "@php -l src/Finding/Severity.php",
            "@php -l src/Mutation/InfectionMutant.php",
            "@php -l src/Mutation/InfectionReport.php",
            "@php -l src/Mutation/InfectionReportParser.php",
            "@php -l src/Mutation/InfectionRunResult.php",
            "@php -l src/Mutation/InfectionRunner.php",
            "@php -l src/Mutation/MutationAnalysisResult.php",
            "@php -l src/Mutation/MutationFileSummary.php",
            "@php -l src/Mutation/MutationFindingFactory.php",
            "@php -l src/Mutation/MutationReportException.php",
            "@php -l src/Parser/AnalysisUnit.php",
            "@php -l src/Parser/ParseDiagnostic.php",
            "@php -l src/Parser/PhpFileParser.php",
            "@php -l src/Reporting/FailThreshold.php",
            "@php -l src/Reporting/JsonReporter.php",
            "@php -l src/Reporting/OutputFormat.php",
            "@php -l src/Reporting/TextReporter.php",
            "@php -l src/Rule/RuleContext.php",
            "@php -l src/Rule/RuleDefinition.php",
            "@php -l src/Rule/RuleInterface.php",
            "@php -l src/Rule/RuleRegistry.php",
            "@php -l src/Rule/Modernisation/ConstructorPromotionCandidateRule.php",
            "@php -l src/Rule/Modernisation/EnumCandidateRule.php",
            "@php -l src/Rule/Modernisation/FirstClassCallableCandidateRule.php",
            "@php -l src/Rule/Modernisation/ForbiddenGlobalAccessRule.php",
            "@php -l src/Rule/Modernisation/MatchExpressionCandidateRule.php",
            "@php -l src/Rule/Modernisation/MixedTypeOveruseRule.php",
            "@php -l src/Rule/Modernisation/ModernisationNodeHelper.php",
            "@php -l src/Rule/Modernisation/NamedArgumentOpportunityRule.php",
            "@php -l src/Rule/Modernisation/PublicPropertyRule.php",
            "@php -l src/Rule/Modernisation/ReadonlyPropertyCandidateRule.php",
            "@php -l src/Rule/Secrets/ApiKeyPatternRule.php",
            "@php -l src/Rule/Secrets/AwsAccessKeyRule.php",
            "@php -l src/Rule/Secrets/DatabaseUrlPasswordRule.php",
            "@php -l src/Rule/Secrets/HardcodedEnvValueRule.php",
            "@php -l src/Rule/Secrets/HighEntropyStringRule.php",
            "@php -l src/Rule/Secrets/JwtTokenRule.php",
            "@php -l src/Rule/Secrets/PhiPatternRule.php",
            "@php -l src/Rule/Secrets/PiiTestFixtureRule.php",
            "@php -l src/Rule/Secrets/PrivateKeyRule.php",
            "@php -l src/Rule/Secrets/SecretScannerHelper.php",
            "@php -l src/Rule/Security/DangerousFunctionCallRule.php",
            "@php -l src/Rule/Security/DisabledSslVerificationRule.php",
            "@php -l src/Rule/Security/ErrorSuppressionRule.php",
            "@php -l src/Rule/Security/ExtractCompactUserInputRule.php",
            "@php -l src/Rule/Security/HeaderInjectionRule.php",
            "@php -l src/Rule/Security/InsecureRandomRule.php",
            "@php -l src/Rule/Security/SecurityNodeHelper.php",
            "@php -l src/Rule/Security/SilentCatchRule.php",
            "@php -l src/Rule/Security/SqlConcatenationRule.php",
            "@php -l src/Rule/Security/UnsafeUnserializeRule.php",
            "@php -l src/Rule/Security/VariableIncludeRule.php",
            "@php -l src/Rule/Security/WeakCryptoRule.php",
            "@php -l src/Rule/TestQuality/ConditionalTestLogicRule.php",
            "@php -l src/Rule/TestQuality/DataProviderAnnotationRule.php",
            "@php -l src/Rule/TestQuality/EagerTestRule.php",
            "@php -l src/Rule/TestQuality/ExcessiveMockingRule.php",
            "@php -l src/Rule/TestQuality/LoopInTestRule.php",
            "@php -l src/Rule/TestQuality/MagicNumberAssertionRule.php",
            "@php -l src/Rule/TestQuality/MockOnlyTestRule.php",
            "@php -l src/Rule/TestQuality/MysteryGuestRule.php",
            "@php -l src/Rule/TestQuality/NoAssertionsRule.php",
            "@php -l src/Rule/TestQuality/PrivateReflectionRule.php",
            "@php -l src/Rule/TestQuality/SetupBloatRule.php",
            "@php -l src/Rule/TestQuality/SkippedWithoutReasonRule.php",
            "@php -l src/Rule/TestQuality/SleepInTestRule.php",
            "@php -l src/Rule/TestQuality/SutNotCalledRule.php",
            "@php -l src/Rule/TestQuality/TestLongerThanSutRule.php",
            "@php -l src/Rule/TestQuality/TestNamingConsistencyRule.php",
            "@php -l src/Rule/TestQuality/TestQualityNodeHelper.php",
            "@php -l src/Rule/TestQuality/TestQualityScope.php",
            "@php -l src/Rule/TestQuality/TrivialAssertionRule.php",
            "@php -l src/Rule/TestQuality/TrivialSnapshotRule.php",
            "@php -l src/Rule/Size/FileLengthRule.php",
            "@php -l src/Rule/SourceTextRuleInterface.php",
            "@php -l src/Source/SourceDiscovery.php",
            "@php -l src/Source/SourceDiscoveryResult.php",
            "@php -l src/Source/SourceFile.php",
            "@php -l tests/Config/ConfigLoaderTest.php",
            "@php -l tests/Console/GruffCliTest.php",
            "@php -l tests/Finding/FindingTest.php",
            "@php -l tests/Mutation/InfectionReportParserTest.php",
            "@php -l tests/Parser/PhpFileParserTest.php",
            "@php -l tests/Rule/RuleRegistryTest.php",
            "@php -l tests/Rule/Modernisation/ModernisationRulesTest.php",
            "@php -l tests/Rule/Secrets/SecretsRulesTest.php",
            "@php -l tests/Rule/Security/SecurityRulesTest.php",
            "@php -l tests/Rule/TestQuality/TestQualityRulesTest.php",
            "@php -l tests/Source/SourceDiscoveryTest.php",
            "@phpstan"
        ],
        "phpstan": "phpstan analyse --configuration=phpstan.neon.dist",
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {},
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
